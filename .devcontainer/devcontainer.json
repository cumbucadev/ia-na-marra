{
  "name": "Agente Newsletter (Isolado)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",

  // Configurações de ambiente no container para acessar o serviço do Koboldcpp
  "containerEnv": {
    "OPENAI_API_BASE": "http://koboldcpp:5001/v1",
    "OPENAI_API_KEY": "any-string-for-kobold",
    "OPENAI_MODEL": "Qwen3-8B"
  },

  // Customizações para o VS Code no container
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.analysis.extraPaths": [
          "/workspace"
        ]
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter"
      ]
    }
  },

  // Comando executado logo após a criação do container
  "postCreateCommand": "pip3 install --user -r requirements.txt",

  // Rodar como usuário não-root por segurança
  "remoteUser": "vscode"
}
